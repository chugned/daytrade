<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd job for the daytrade learning observer.

  Keeps the bot alive across crashes and reboots. Loads as a *user agent*
  (per-user, no root) so it inherits your shell/network without elevation.

  Install:
      cp deploy/launchd/com.daytrade.learn.plist ~/Library/LaunchAgents/
      launchctl load -w ~/Library/LaunchAgents/com.daytrade.learn.plist

  Stop:
      launchctl unload ~/Library/LaunchAgents/com.daytrade.learn.plist

  Logs go to logs/launchd.learn.{out,err}.log.

  IMPORTANT: edit the WorkingDirectory below to the absolute path of your
  daytrade checkout before loading.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.daytrade.learn</string>

    <!-- Replace with the absolute path to your daytrade clone. -->
    <key>WorkingDirectory</key>
    <string>/Users/CHANGE_ME/Desktop/coding/daytrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>daytrade</string>
        <string>learn</string>
        <string>--days</string>
        <string>30</string>
        <string>--interval</string>
        <string>60</string>
        <string>--real-data</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>src</string>
    </dict>

    <!-- Restart on exit; wait 10s between restarts to avoid tight crash loops. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>logs/launchd.learn.out.log</string>
    <key>StandardErrorPath</key>
    <string>logs/launchd.learn.err.log</string>
</dict>
</plist>
