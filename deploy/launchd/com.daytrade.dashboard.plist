<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd job for the daytrade dashboard.

  Keeps the dashboard process alive across crashes (which has happened
  twice in the live run with no obvious cause). Same load/unload pattern
  as the learn plist.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.daytrade.dashboard</string>

    <key>WorkingDirectory</key>
    <string>/Users/CHANGE_ME/Desktop/coding/daytrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>daytrade</string>
        <string>dashboard</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>src</string>
    </dict>

    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>logs/launchd.dashboard.out.log</string>
    <key>StandardErrorPath</key>
    <string>logs/launchd.dashboard.err.log</string>
</dict>
</plist>
